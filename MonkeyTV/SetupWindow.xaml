<Window x:Class="MonkeyTV.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Monkey TV" Width="1040" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border x:Name="SetupRoot" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Opacity="0" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
    <Border.RenderTransform><ScaleTransform x:Name="SetupScale" ScaleX=".99" ScaleY=".99"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="34" ShadowDepth="8" Opacity=".34"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="62" Height="62"><Image Source="Assets/Brand/monkey-tv-logo.png" Stretch="Uniform"/></Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Monkey TV" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Create your streaming home" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="FIRST-TIME SETUP" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
          <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="0" Width="36" Height="36" Click="CloseSetup_Click" ToolTip="Close setup"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="28,32">
          <StackPanel>
            <TextBlock Text="Your setup" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="A few choices, then you’re ready to watch." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" FontSize="14" Margin="0,7,0,27"/>
            <Border x:Name="Step1Surface" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentBrush}"><TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Step1Label" Grid.Column="1" Text="Add services" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid></Border>
            <Border x:Name="Step2Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource ControlBrush}"><TextBlock Text="2" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Step2Label" Grid.Column="1" Text="Appearance" FontSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid></Border>
            <Border x:Name="Step3Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource ControlBrush}"><TextBlock Text="3" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Step3Label" Grid.Column="1" Text="VPN Location" FontSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid></Border>
            <Border x:Name="Step4Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource ControlBrush}"><TextBlock Text="4" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Step4Label" Grid.Column="1" Text="Finish" FontSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid></Border>
          </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="52,42,52,38">
          <Grid x:Name="ServicesStep">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Choose your services" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Build the launcher around the streaming sites you use. Monkey TV won’t contact a provider until you open one from Home." Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="0,10,0,26" TextWrapping="Wrap" LineHeight="23"/></StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,26">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetupServiceSearchBox" TextChanged="SetupServiceFilter_Changed" Padding="12,9" ToolTip="Search built-in services"/>
                  <ComboBox x:Name="SetupServiceRegionBox" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="SetupServiceFilter_Changed"><ComboBoxItem Content="All"/><ComboBoxItem Content="Global"/><ComboBoxItem Content="Canada"/><ComboBoxItem Content="USA"/><ComboBoxItem Content="UK"/><ComboBoxItem Content="Other"/></ComboBox>
                </Grid>
                <ListBox x:Name="SetupServicesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="90" Height="51" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource ControlBrush}"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                      <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Template.Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                      <ToggleButton Grid.Column="2" IsChecked="{Binding Enabled}" Checked="SetupServiceSelection_Changed" Unchecked="SetupServiceSelection_Changed" VerticalAlignment="Center" MinWidth="72" Height="32" Padding="10,0"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="Off"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Switch" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><TextBlock x:Name="State" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="State" Property="Foreground" Value="White"/><Setter Property="Content" Value="On"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ToggleButton.Style></ToggleButton>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Grid Grid.Row="2"><Button Content="Add custom service" Click="AddCustomService_Click" HorizontalAlignment="Left"/><Button Style="{StaticResource AccentButton}" Content="Continue" Click="ServicesDone_Click" HorizontalAlignment="Right" MinWidth="128"/></Grid>
          </Grid>
          <Grid x:Name="AppearanceStep" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Make it feel like yours" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="These choices can be changed later in Settings." Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="0,10,0,30"/>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel><TextBlock Text="HOME PRESENTATION" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Card style" Margin="0,0,0,9" FontWeight="SemiBold" FontSize="16"/><ComboBox x:Name="CardStyleBox" SelectedIndex="0"><ComboBoxItem Content="Banner"/><ComboBoxItem Content="Square"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Card size" Margin="0,0,0,9" FontWeight="SemiBold" FontSize="16"/><ComboBox x:Name="TileSizeBox" SelectedIndex="1"><ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/></ComboBox></StackPanel></Grid><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24,0,21"/><CheckBox x:Name="ShowNamesCheck" Content="Show service names" IsChecked="True" FontSize="16" Margin="0,0,0,18"/><CheckBox x:Name="ShowClockCheck" Content="Show clock in the top bar" IsChecked="True" FontSize="16"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back" Click="AppearanceBack_Click" Margin="0,0,10,0"/><Button Style="{StaticResource AccentButton}" Content="Continue" Click="AppearanceDone_Click" MinWidth="128"/></StackPanel>
          </Grid>
          <Grid x:Name="LocationStep" Visibility="Collapsed"><Grid VerticalAlignment="Center" MaxWidth="560"><StackPanel><TextBlock Text="VPN Location" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Optionally choose supported NordVPN locations for Monkey TV browser traffic. This affects Monkey TV only, not the rest of Windows." Foreground="{DynamicResource MutedBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,25"/><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSubtleBrush}"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Set it up whenever you’re ready" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Monkey TV always starts Direct and never connects automatically." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border><StackPanel Orientation="Horizontal" Margin="0,28,0,0"><Button Style="{StaticResource AccentButton}" Content="Set up VPN Location" Click="SetUpLocation_Click" Margin="0,0,10,0"/><Button Content="Skip for now" Click="SkipLocation_Click"/></StackPanel></StackPanel></Grid></Grid>
          <Grid x:Name="LocationCredentialsStep" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" MaxWidth="560"><TextBlock Text="Set up NordVPN" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Use NordVPN service credentials for supported manual connections. These are separate from your normal Nord Account email and password." Foreground="{DynamicResource MutedBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,23"/><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel><Button Content="Get NordVPN service credentials ↗" Click="GetNordCredentials_Click" HorizontalAlignment="Left" Background="Transparent" Padding="0,4" Margin="0,0,0,22"/><TextBlock Text="Service username" FontWeight="SemiBold"/><TextBox x:Name="NordUsernameBox" Margin="0,8,0,17"/><TextBlock Text="Service password" FontWeight="SemiBold"/><PasswordBox x:Name="NordPasswordBox" Margin="0,8,0,16"/><TextBlock x:Name="NordSetupStatus" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource AccentButton}" Content="Save and continue" Click="SaveLocationCredentials_Click" Margin="0,0,10,0"/><Button Content="Skip for now" Click="SkipLocation_Click"/></StackPanel></StackPanel></Grid>
          <Grid x:Name="FinishStep" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="490"><Border Width="82" Height="82" Background="{DynamicResource AccentBrush}" CornerRadius="24"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock Text="Your streaming home is ready" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,10"/><TextBlock Text="Your selected services and preferences stay in Monkey TV’s portable Data folder." Foreground="{DynamicResource MutedBrush}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23"/><Button Style="{StaticResource AccentButton}" Content="Open Monkey TV" Click="OpenMonkeyTV_Click" Margin="0,34,0,0" HorizontalAlignment="Center" MinWidth="188"/></StackPanel></Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
