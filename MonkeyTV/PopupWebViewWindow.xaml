<Window x:Class="MonkeyTV.PopupWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Monkey TV sign-in" Width="760" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid><TextBlock Text="Secure sign-in or account window" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click"/>
      </Grid>
    </Border>
    <wv2:WebView2 x:Name="PopupView" Grid.Row="1"/>
  </Grid>
</Window>
