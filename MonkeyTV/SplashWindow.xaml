<Window x:Class="MonkeyTV.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="620" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="24" Padding="32">
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="390" Height="390" CornerRadius="22" Background="Black" ClipToBounds="True">
          <Image Source="Assets/Brand/monkey-tv-logo.jpg" Stretch="UniformToFill"/>
        </Border>
        <TextBlock Text="Monkey TV" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <ProgressBar IsIndeterminate="True" Width="132" Height="3" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" Margin="0,19,0,0"/>
      </StackPanel>
      <TextBlock x:Name="VersionText" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
    </Grid>
  </Border>
</Window>
