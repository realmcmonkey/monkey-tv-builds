<Window x:Class="MonkeyTV.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="430" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent">
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="38" ShadowDepth="10" Opacity=".38"/></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="34">
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <Border Width="184" Height="184" HorizontalAlignment="Center">
              <Image Source="Assets/Brand/monkey-tv-logo.png" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Monkey TV" FontSize="30" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="STREAMING HOME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="1,7,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border VerticalAlignment="Bottom" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="42,36,42,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Getting your streaming home ready" FontSize="21" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="Monkey TV is starting" FontSize="34" FontWeight="SemiBold"/>
          <TextBlock Text="Your services stay private until you choose one." Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="0,10,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}"/>
          <TextBlock x:Name="VersionText" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,13,0,0"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
