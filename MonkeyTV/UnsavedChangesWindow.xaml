<Window x:Class="MonkeyTV.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes" Width="560" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border x:Name="DialogSurface" Background="{DynamicResource SurfaceBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="32" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="DialogScale" ScaleX=".985" ScaleY=".985"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity=".32"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left" Margin="0,0,0,17"><TextBlock Text="UNSAVED CHANGES" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
        <TextBlock Text="Unsaved changes" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="Message" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" FontSize="16" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Keep Editing" IsDefault="True" IsCancel="True" Click="KeepEditing_Click" Margin="0,0,10,0" MinWidth="118"/>
        <Button Content="Discard Changes" Click="Discard_Click" Margin="0,0,10,0" MinWidth="132"/>
        <Button Content="Save Changes" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="122"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
