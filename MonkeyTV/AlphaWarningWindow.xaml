<Window x:Class="MonkeyTV.AlphaWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey TV" Width="700" Height="480" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border x:Name="DialogSurface" Background="{DynamicResource BackgroundBrush}" CornerRadius="22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" Opacity="0" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
    <Border.RenderTransform><ScaleTransform x:Name="DialogScale" ScaleX=".985" ScaleY=".985"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="34" ShadowDepth="9" Opacity=".38"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="124"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="36,22">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="72" Height="72"><Image Source="Assets/Brand/monkey-tv-logo.png" Stretch="Uniform"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="Monkey TV" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="EARLY ACCESS" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="38,30,38,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Welcome to the alpha" FontSize="32" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Monkey TV is ready for hands-on testing." Foreground="{DynamicResource MutedBrush}" FontSize="17" Margin="0,9,0,0"/>
        <Border Grid.Row="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="21" Margin="0,25,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="What to expect" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Features may be incomplete, unstable, or change in later builds. Keep a backup of your portable Data folder while testing." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="15" LineHeight="22" Margin="0,7,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="38,20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="DontShowCheck" Content="Don’t show again for this version" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Exit" Click="Exit_Click" Margin="0,0,10,0" MinWidth="100"/><Button Style="{StaticResource AccentButton}" Content="Continue" Click="Continue_Click" MinWidth="126"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
