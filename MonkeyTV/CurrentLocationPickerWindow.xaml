<Window x:Class="MonkeyTV.CurrentLocationPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Current Location" Width="430" Height="560" MinWidth="380" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Button x:Name="BackButton" Content="← Back" Click="Back_Click" HorizontalAlignment="Left" Visibility="Collapsed" Padding="0" Background="Transparent"/><TextBlock x:Name="TitleText" Text="Current Location" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock x:Name="DescriptionText" Text="Choose the browser route Monkey TV should use." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <ListBox x:Name="LocationsList" Grid.Row="1" Margin="0,20,0,16" SelectionChanged="LocationsList_SelectionChanged" MouseDoubleClick="LocationsList_DoubleClick" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
    <Grid Grid.Row="2"><TextBlock x:Name="SelectedText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="Connect" Click="Connect_Click" IsEnabled="False"/></StackPanel></Grid>
  </Grid>
</Window>
