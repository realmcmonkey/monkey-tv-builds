<Window x:Class="MonkeyTV.CurrentLocationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Current Location" Width="980" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <Style x:Key="PickerListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Padding="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.56"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickerTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,4,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,14,0">
          <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Current Location" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Choose the browser route Monkey TV should use." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Starts Direct" FontWeight="SemiBold"/><TextBlock Text=" every time" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="SELECT ROUTE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,10"/>
          <Button x:Name="LastUsedButton" Grid.Row="1" Visibility="Collapsed" Click="LastUsed_Click" Padding="12" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalContentAlignment="Left" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="LAST USED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="LastUsedText" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="Select it, then connect" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
          </Button>
          <ListBox x:Name="CountryList" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="CountryList_SelectionChanged" ItemContainerStyle="{StaticResource PickerListItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="{Binding ChevronVisibility}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="CountryHeadingText" Text="United States" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="CountryDescriptionText" Text="Choose a documented SOCKS5 location, then connect." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
              <Button x:Name="ClearSelectionButton" Grid.Column="1" Content="Clear selection" Click="ClearSelection_Click" Visibility="Collapsed" Padding="11,7" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,18,0,12">
              <TextBox x:Name="SearchBox" Style="{StaticResource PickerTextBox}" TextChanged="SearchBox_TextChanged" Padding="13,10"/>
              <TextBlock x:Name="SearchPlaceholder" Text="Search locations or cities" Foreground="{DynamicResource MutedBrush}" Margin="14,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="2">
              <ListBox x:Name="LocationsList" BorderThickness="0" Background="Transparent" SelectionChanged="LocationsList_SelectionChanged" ItemContainerStyle="{StaticResource PickerListItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="UnavailablePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center"><TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="UnavailableTitleText" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="UnavailableDescriptionText" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="4,18,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="Connect" Click="Connect_Click" IsEnabled="False" MinWidth="108"/></StackPanel>
    </Grid>
  </Grid>
</Window>
