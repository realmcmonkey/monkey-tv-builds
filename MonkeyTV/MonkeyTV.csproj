<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MonkeyTV</AssemblyName>
    <RootNamespace>MonkeyTV</RootNamespace>
    <VersionPrefix>0.05</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <BuildNumber>1</BuildNumber>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.1</FileVersion>
    <InformationalVersion>0.05-alpha+build.1</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <ApplicationIcon>Assets\Brand\monkey-tv.ico</ApplicationIcon>
    <IncludeVpnV2Dependencies Condition="'$(IncludeVpnV2Dependencies)' == ''">true</IncludeVpnV2Dependencies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DefaultArtwork\**\*.jpg" />
    <Resource Include="Assets\Brand\monkey-tv-logo.jpg" />
    <Compile Include="..\tests\MonkeyTV.VpnProxyProof\WfpContainmentSpike.cs" Link="Networking\WfpContainmentPolicy.cs" />
  </ItemGroup>

  <Target Name="CopyExperimentalVpnV2Helper" AfterTargets="Build" Condition="'$(IncludeVpnV2Dependencies)' == 'true' and Exists('$(MSBuildProjectDirectory)\..\Runtime\VpnV2\MonkeyTV.UserSpaceOpenVpnProof.exe')">
    <ItemGroup>
      <VpnV2NativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\MonkeyTV.UserSpaceOpenVpnProof.exe" />
      <VpnV2NativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\libcrypto-3-x64.dll" />
      <VpnV2NativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\libssl-3-x64.dll" />
      <VpnV2NativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\lz4.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VpnV2NativeFile)" DestinationFolder="$(TargetDir)Data\Requirements\VpnV2" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExperimentalVpnV2HelperToPublish" AfterTargets="Publish" Condition="'$(IncludeVpnV2Dependencies)' == 'true' and Exists('$(MSBuildProjectDirectory)\..\Runtime\VpnV2\MonkeyTV.UserSpaceOpenVpnProof.exe')">
    <ItemGroup>
      <VpnV2PublishedNativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\MonkeyTV.UserSpaceOpenVpnProof.exe" />
      <VpnV2PublishedNativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\libcrypto-3-x64.dll" />
      <VpnV2PublishedNativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\libssl-3-x64.dll" />
      <VpnV2PublishedNativeFile Include="$(MSBuildProjectDirectory)\..\Runtime\VpnV2\lz4.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VpnV2PublishedNativeFile)" DestinationFolder="$(PublishDir)Data\Requirements\VpnV2" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFixedWebView2RuntimeToPublish" AfterTargets="Publish" Condition="'$(IncludeVpnV2Dependencies)' == 'true' and Exists('$(MSBuildProjectDirectory)\..\Runtime\WebView2Fixed\msedgewebview2.exe')">
    <ItemGroup>
      <FixedWebViewRuntime Include="$(MSBuildProjectDirectory)\..\Runtime\WebView2Fixed\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixedWebViewRuntime)"
          DestinationFiles="@(FixedWebViewRuntime->'$(PublishDir)Data\Requirements\WebView2Fixed\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveWebView2ReferenceDocumentation" AfterTargets="Publish">
    <ItemGroup>
      <WebView2ReferenceDocumentation Include="$(PublishDir)Microsoft.Web.WebView2.*.xml" />
    </ItemGroup>
    <Delete Files="@(WebView2ReferenceDocumentation)" />
  </Target>
</Project>
