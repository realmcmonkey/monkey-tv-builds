<Window x:Class="MonkeyTV.ManageServicesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Services" Width="900" Height="680" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Choose / Manage Services" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select built-in streaming services for Home. This library is local; no provider websites are contacted." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,20"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="12,8" ToolTip="Search services"/>
      <ComboBox x:Name="RegionBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="All"/><ComboBoxItem Content="Global"/><ComboBoxItem Content="Canada"/><ComboBoxItem Content="USA"/><ComboBoxItem Content="UK"/><ComboBoxItem Content="Other"/></ComboBox>
      <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="Enable All" Click="EnableAll_Click" Margin="0,0,8,0"/><Button Content="Disable All" Click="DisableAll_Click"/></StackPanel>
    </Grid>
    <ListBox x:Name="ServicesList" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" SelectionChanged="ServicesList_SelectionChanged">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="82" Height="46" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlBrush}"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Template.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
        <CheckBox Grid.Column="2" Tag="{Binding}" IsChecked="{Binding Enabled}" Checked="ServiceChecked" Unchecked="ServiceChecked" VerticalAlignment="Center" Content="Enabled"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Content="Restore Defaults" Click="RestoreDefaults_Click"/><Button Content="+ Add Custom Service" Click="AddCustom_Click" Margin="10,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button Style="{StaticResource AccentButton}" Content="Save" Click="Save_Click"/></StackPanel></Grid>
  </Grid>
</Window>
