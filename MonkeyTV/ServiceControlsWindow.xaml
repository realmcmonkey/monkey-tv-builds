<Window x:Class="MonkeyTV.ServiceControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="326" Height="58" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Opacity="0">
  <Window.Resources>
    <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" Margin="10,5,10,10" CornerRadius="17"
          Background="#E6191A20" BorderBrush="#30FFFFFF" BorderThickness="1"
          Padding="7,3" MouseEnter="Surface_MouseEnter" MouseMove="Surface_MouseMove">
    <Border.RenderTransform><TranslateTransform Y="-8"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="5" Opacity="0.48"/></Border.Effect>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Style="{StaticResource OverlayButton}" Content="&#xE72B;" ToolTip="Back" Click="Back_Click"/>
      <Button Style="{StaticResource OverlayButton}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click"/>
      <Border Width="1" Height="23" Background="#35FFFFFF" Margin="7,0" VerticalAlignment="Center"/>
      <Button Style="{StaticResource OverlayButton}" Width="68" ToolTip="Return Home"
              PreviewMouseLeftButtonUp="Home_PreviewMouseLeftButtonUp" Click="Home_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="Home" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold"/></StackPanel>
      </Button>
      <Border Width="1" Height="23" Background="#35FFFFFF" Margin="7,0" VerticalAlignment="Center"/>
      <Button x:Name="FullscreenButton" Style="{StaticResource OverlayButton}" Content="&#xE740;" ToolTip="Toggle application fullscreen (F11)" Click="Fullscreen_Click"/>
    </StackPanel>
  </Border>
</Window>
