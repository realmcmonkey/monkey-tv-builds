<Window x:Class="MonkeyTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey TV" Width="1280" Height="800" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#FF101116" PreviewKeyDown="Window_KeyDown" MouseMove="Window_MouseMove">
  <Window.Resources>
    <Style x:Key="ServiceCardButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="CardRoot" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardRoot" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardRoot" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Grid x:Name="HomeView" ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF111219" Offset="0"/>
          <GradientStop Color="#FF0C0D12" Offset="0.62"/>
          <GradientStop Color="#FF12111A" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Ellipse Width="760" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-300,0,0" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#247C5CFC" Offset="0"/><GradientStop Color="#007C5CFC" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="620" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-260" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#123A79A8" Offset="0"/><GradientStop Color="#003A79A8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="HomeHeader" Margin="46,30,46,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="13" Margin="0,0,15,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8C70FF"/><GradientStop Color="#FF6547DE" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#FF6B4CE6"/></Border.Effect>
              <TextBlock Text="M" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Monkey TV" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Your streaming services" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="SearchContainer" Visibility="Collapsed" CornerRadius="18" Background="#CC24262E" BorderBrush="#33FFFFFF" BorderThickness="1" Height="38" Margin="0,0,8,0">
              <Grid Width="210">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="13,8" TextChanged="SearchBox_TextChanged" ToolTip="Search configured services"/>
                <Button Grid.Column="1" Content="×" Background="Transparent" Padding="0" FontSize="18" Click="CloseSearch_Click" ToolTip="Close search"/>
              </Grid>
            </Border>
            <Button Width="38" Height="38" Padding="0" Background="#CC24262E" Click="SearchToggle_Click" ToolTip="Search services" Margin="0,0,8,0">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
            </Button>
            <Button x:Name="HeaderAddServiceButton" Padding="12,8" Background="Transparent" Click="AddService_Click" ToolTip="Add service" Margin="0,0,4,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Add service" FontSize="13"/></StackPanel>
            </Button>
            <TextBlock x:Name="ClockText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,16,0"/>
            <Button Width="38" Height="38" Padding="0" Background="#CC24262E" Click="Settings_Click" ToolTip="Settings" Margin="0,0,8,0">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Button Width="38" Height="38" Padding="0" Background="#CC24262E" Click="Fullscreen_Click" ToolTip="Toggle fullscreen (F11)">
              <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="46,8,34,42">
          <StackPanel>
            <StackPanel Margin="0,0,12,19">
              <TextBlock Text="Your services" FontSize="28" FontWeight="SemiBold"/>
              <TextBlock x:Name="ServicesSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <WrapPanel x:Name="ServicesPanel" HorizontalAlignment="Left"/>
            <Border x:Name="EmptyState" Visibility="Collapsed" Background="#661D1F27" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="18" Padding="32" MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0">
              <StackPanel>
                <TextBlock x:Name="EmptyTitle" Text="Your services will appear here" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="EmptyDescription" Text="Add a streaming website to create your first launcher card. Nothing is loaded until you click it." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,18"/>
                <Button x:Name="EmptyAddButton" Content="Add a service" HorizontalAlignment="Left" Click="AddService_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="BrowserView" Visibility="Collapsed" Background="Black">
      <Border x:Name="BrowserControls" Visibility="Collapsed" Background="#FF17181D" Padding="12,8">
        <StackPanel Orientation="Horizontal">
          <Button Content="←" Click="BrowserBack_Click" Padding="11,7" ToolTip="Back"/>
          <Button Content="↻" Click="BrowserReload_Click" Padding="11,7" ToolTip="Reload" Margin="4,0"/>
          <Button Content="⌂  Home" Click="BrowserHome_Click" Padding="12,7" ToolTip="Return Home; reopen this service to resume it"/>
          <Button Content="⛶" Click="Fullscreen_Click" Padding="11,7" ToolTip="Toggle fullscreen (F11)" Margin="4,0,0,0"/>
        </StackPanel>
      </Border>
      <Grid x:Name="BrowserHost"/>
      <Border x:Name="LoadingOverlay" Background="#FF101116">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
          <Border Width="240" Height="135" CornerRadius="20" Background="#FF1C1D24" BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Border.Effect><DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="7" Opacity="0.32"/></Border.Effect>
            <Grid>
              <Image x:Name="LoadingArtwork" Stretch="Uniform" Margin="14" Visibility="Collapsed"/>
              <TextBlock x:Name="LoadingInitial" Text="M" FontSize="42" FontWeight="SemiBold" Foreground="#FFD9D0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TextBlock x:Name="LoadingText" Text="Launching service…" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Width="128" Height="3" Foreground="#FF7C5CFC" Background="#332D2F38" Margin="0,18,0,0"/>
          <Button Content="Home" Click="BrowserHome_Click" Padding="15,8" Margin="0,22,0,0" HorizontalAlignment="Center" ToolTip="Return to Monkey TV Home"/>
        </StackPanel>
      </Border>
      <Border x:Name="ErrorOverlay" Visibility="Collapsed" Background="#FF101116">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
          <Border Width="50" Height="50" CornerRadius="16" Background="#2E7C5CFC" HorizontalAlignment="Left"><TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="ErrorTitle" Text="Couldn't load this service" FontSize="25" FontWeight="SemiBold" Margin="0,20,0,0"/>
          <TextBlock x:Name="ErrorMessage" Text="Something went wrong while connecting to this service." Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Style="{StaticResource AccentButton}" Content="Retry" Click="RetryService_Click" Margin="0,0,10,0"/><Button Content="Home" Click="BrowserHome_Click"/></StackPanel>
          <Expander Header="Technical details" Margin="0,18,0,0"><TextBlock x:Name="ErrorDetails" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/></Expander>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
