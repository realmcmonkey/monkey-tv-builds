<Window x:Class="MonkeyTV.ArtworkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose service artwork" Width="960" Height="720" MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,19"><StackPanel Orientation="Horizontal"><Border Width="58" Height="58" CornerRadius="15" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Artwork library" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Choose a built-in banner or import your own image" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/></StackPanel></StackPanel></Border>
    <Grid Grid.Row="1" Margin="32,22,32,16"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Search built-in artwork" TextChanged="SearchBox_TextChanged" Padding="12,9"/><TextBlock Grid.Column="1" Text="Artwork is copied into Monkey TV’s portable Data folder when you save." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/></Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="32,0,32,22" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ArtworkGroups" Margin="8,4,8,12"/></ScrollViewer></Border>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Choose from computer…" Click="ChooseFile_Click" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="Cancel" Click="Cancel_Click"/></Grid></Border>
  </Grid>
</Window>
