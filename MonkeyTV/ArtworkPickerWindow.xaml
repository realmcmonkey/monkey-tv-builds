<Window x:Class="MonkeyTV.ArtworkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose service artwork" Width="900" Height="680" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Choose service artwork" FontSize="27" FontWeight="SemiBold"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,18,0,18" Width="300" HorizontalAlignment="Left"
             ToolTip="Search built-in artwork" TextChanged="SearchBox_TextChanged"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ArtworkGroups" Margin="0,0,8,12"/>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="Choose from computer…" Click="ChooseFile_Click" HorizontalAlignment="Left"/>
      <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click"/>
    </Grid>
  </Grid>
</Window>
