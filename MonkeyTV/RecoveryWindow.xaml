<Window x:Class="MonkeyTV.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey TV" Width="520" Height="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True">
  <Border Background="#FB1B1C22" CornerRadius="18" BorderBrush="#553F414B" BorderThickness="1" Padding="34">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Border Width="44" Height="44" CornerRadius="14" Background="#337C5CFC" HorizontalAlignment="Left"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Monkey TV didn't close normally last time" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock Text="Any active streaming session was closed. Your services and settings are still available." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
      </StackPanel>
      <Button Grid.Row="1" Style="{StaticResource AccentButton}" Content="Continue to Home" HorizontalAlignment="Right" Click="Continue_Click"/>
    </Grid>
  </Border>
</Window>
