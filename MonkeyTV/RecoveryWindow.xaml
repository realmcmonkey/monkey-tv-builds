<Window x:Class="MonkeyTV.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey TV" Width="630" Height="390" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True">
  <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity=".34"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,17"><StackPanel Orientation="Horizontal"><Border Width="58" Height="58"><Image Source="Assets/Brand/monkey-tv-logo.png" Stretch="Uniform"/></Border><StackPanel Margin="15,0,0,0" VerticalAlignment="Center"><TextBlock Text="Monkey TV" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="RECOVERY" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></StackPanel></Border>
      <Grid Grid.Row="1" Margin="34,27,34,22"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="HeadingText" Text="Monkey TV didn't close normally last time" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="MessageText" Text="Any active streaming session was closed. Your services and settings are still available." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" FontSize="15" Margin="0,12,0,0"/></StackPanel></Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenDataButton" Content="Open Data Folder" Visibility="Collapsed" Click="OpenData_Click" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RestoreButton" Content="Restore Last Working Configuration" Visibility="Collapsed" Click="Restore_Click" Margin="0,0,9,0"/><Button x:Name="FreshButton" Content="Start Fresh" Visibility="Collapsed" Click="Fresh_Click" Margin="0,0,9,0"/><Button x:Name="ContinueButton" Style="{StaticResource AccentButton}" Content="Continue to Home" Click="Continue_Click"/></StackPanel></Grid></Border>
    </Grid>
  </Border>
</Window>
