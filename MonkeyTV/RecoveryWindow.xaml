<Window x:Class="MonkeyTV.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monkey TV" Width="520" Height="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="34">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock x:Name="HeadingText" Text="Monkey TV didn't close normally last time" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock x:Name="MessageText" Text="Any active streaming session was closed. Your services and settings are still available." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenDataButton" Content="Open Data Folder" Visibility="Collapsed" Click="OpenData_Click" Margin="0,0,8,0"/><Button x:Name="RestoreButton" Content="Restore Last Working Configuration" Visibility="Collapsed" Click="Restore_Click" Margin="0,0,8,0"/><Button x:Name="FreshButton" Content="Start Fresh" Visibility="Collapsed" Click="Fresh_Click" Margin="0,0,8,0"/><Button x:Name="ContinueButton" Style="{StaticResource AccentButton}" Content="Continue to Home" Click="Continue_Click"/></StackPanel>
    </Grid>
  </Border>
</Window>
