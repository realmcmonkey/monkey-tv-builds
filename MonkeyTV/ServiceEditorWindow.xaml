<Window x:Class="MonkeyTV.ServiceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service" Width="860" Height="820" MinWidth="720" MinHeight="640" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
    <StackPanel Margin="0,0,10,0">
      <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" Text="Add service" FontSize="26" FontWeight="SemiBold"/><Button Grid.Column="1" Content="✕" Width="38" Height="38" Padding="0" Click="ImplicitDismiss_Click" ToolTip="Close editor"/></Grid>
      <TextBlock Text="Only the name and website are required." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,26"/>
      <TextBlock Text="Service name" Margin="0,0,0,7"/>
      <TextBox x:Name="NameBox" TextChanged="DraftField_Changed" Margin="0,0,0,18"/>
      <TextBlock Text="Service URL" Margin="0,0,0,7"/>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlBox" TextChanged="DraftField_Changed"/><Button Grid.Column="1" Content="Test URL" Click="TestUrl_Click" Margin="10,0,0,0" Style="{StaticResource AccentButton}"/></Grid>
      <TextBlock x:Name="UrlValidationText" Foreground="#FFFF7777" FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap"/>
      <TextBlock Text="Preferred VPN Location" Margin="0,0,0,7"/>
      <ComboBox x:Name="PreferredVpnLocationBox" SelectedIndex="0" SelectionChanged="DraftField_Changed" Width="230" HorizontalAlignment="Left" Margin="0,0,0,8">
        <ComboBoxItem Content="None"/>
        <ComboBoxItem Content="Direct"/>
        <ComboBoxItem Content="USA"/>
        <ComboBoxItem Content="Canada"/>
        <ComboBoxItem Content="United Kingdom"/>
      </ComboBox>
      <TextBlock Text="Optional. Monkey TV asks before switching location when you open this service."
                 Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <TextBlock Text="Icon" Margin="0,0,0,7"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
        <TextBlock x:Name="IconStatus" Text="Automatically obtain from website" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Width="310" TextTrimming="CharacterEllipsis"/>
        <Button Content="Choose image…" Click="ChooseIcon_Click"/>
      </StackPanel>
      <TextBlock Text="Banner artwork" Margin="0,0,0,7"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock x:Name="BannerStatus" Text="Automatically choose built-in or website artwork" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Width="310" TextTrimming="CharacterEllipsis"/>
        <Button Content="Change…" Click="ChooseBanner_Click" Margin="0,0,8,0"/>
        <Button Content="Reset" Click="ResetBanner_Click"/>
      </StackPanel>
      <TextBlock Text="Wide artwork is used in Banner card mode. Imported images are copied into the portable Data folder."
                 Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock Text="Banner fit" Margin="0,0,0,7"/>
      <ComboBox x:Name="BannerFitBox" SelectedIndex="0" SelectionChanged="DraftField_Changed" Width="190" HorizontalAlignment="Left" Margin="0,0,0,16">
        <ComboBoxItem Content="Fill"/>
        <ComboBoxItem Content="Fit"/>
      </ComboBox>
      <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,24">
        <StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="Live card preview" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Updates while you edit" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Border x:Name="PreviewCard" Height="349" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" ClipToBounds="True"><Grid x:Name="PreviewHost"/></Border><TextBlock x:Name="PreviewNameText" FontWeight="SemiBold" Margin="4,11,4,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Border>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,22"/>
      <TextBlock Text="Experience" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Choose how this service identifies its browser." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
      <ComboBox x:Name="ExperienceBox" SelectionChanged="ExperienceBox_SelectionChanged" SelectedIndex="0" Margin="0,0,0,12">
        <ComboBoxItem Content="Default Experience"/>
        <ComboBoxItem Content="TV Experience"/>
      </ComboBox>
      <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,16"><StackPanel><TextBlock Text="Effective browser configuration" FontWeight="SemiBold"/><TextBlock x:Name="ExperienceSummaryText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="EffectiveUserAgentText" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Test configuration" Click="TestConfiguration_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border x:Name="TvExperienceWarning" Visibility="Collapsed" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,16">
        <TextBlock Text="TV Experience uses a smart-TV browser identity to request a TV-optimized interface. Not all streaming services provide a TV web interface, so some services may show their normal interface or may not work correctly."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
      </Border>
      <Expander Header="Advanced" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0">
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Custom user-agent override (optional)" Margin="0,0,0,7"/>
          <TextBox x:Name="CustomUserAgentBox" TextChanged="DraftField_Changed" TextWrapping="Wrap" MinHeight="65" ToolTip="Enter a complete user-agent string"/>
          <TextBlock Text="When set, this override takes precedence over the selected Experience's automatic browser identity. Leave it empty for normal Experience behavior."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,9,0,0"/>
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16"/>
          <TextBlock Text="Browser data" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="Reset this service's saved website data so it behaves like a first visit the next time it opens. This happens immediately and does not require Save."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,10"/>
          <Button x:Name="ClearDataButton" Content="Reset Service…" HorizontalAlignment="Left" Click="ClearData_Click"/>
          <TextBlock x:Name="ClearDataStatus" Foreground="#FFFFC66D" Margin="0,8,0,0"/>
        </StackPanel>
      </Expander>
      <TextBlock x:Name="ErrorText" Foreground="#FFFF7777" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
      <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Add service" Click="Save_Click" MinWidth="120"/>
    </StackPanel>
  </Grid>
</Window>
